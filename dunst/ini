[global]
    monitor = 0
    origin = top-right
    offset = 10x10
    width = 300
    height = 100
    gap_size = 5
    frame_width = 2
    frame_color = "#89b4fa"
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    highlight = "#89b4fa"
    corner_radius = 8
    font = JetBrainsMono Nerd Font 11
    format = "<b>%s</b>\n%b"
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true
    sort = urgency_descending
    timeout = 5

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 3

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_critical]
    background = "#f38ba8"
    foreground = "#1e1e2e"
    frame_color = "#f38ba8"
    timeout = 0
